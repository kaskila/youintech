# Neon Postgres — POOLED connection (host contains "-pooler").
# Used by the Prisma Client at runtime (src/lib/db.ts), via the pg driver adapter.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon Postgres — UNPOOLED/DIRECT connection (no "-pooler" in the host).
# Used only by the Prisma CLI (prisma.config.ts) for migrations. Migrations
# run through PgBouncer hang instead of failing cleanly, so this must bypass it.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
