# Postgres connection. Local dev uses a native local Postgres 17 instance —
# see README.md "Local setup" for the CREATE ROLE / CREATE DATABASE steps.
# There is no pooler locally, so DATABASE_URL and DIRECT_URL are identical.
#
# In production (Vercel), these point to Neon instead: DATABASE_URL to the
# POOLED host ("-pooler" in the hostname) for runtime queries, DIRECT_URL to
# the UNPOOLED host for Prisma CLI migrations (which hang through PgBouncer
# rather than failing cleanly). Neon is production-only — see CLAUDE.md §3.
DATABASE_URL="postgresql://youintech:password@localhost:5432/youintech_db"
DIRECT_URL="postgresql://youintech:password@localhost:5432/youintech_db"

# Better Auth (admin-only authentication for /admin). Generate a secret with:
# openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-generated-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Seeded ADMIN account — created by prisma/seed.ts through Better Auth's own
# password hashing. Change these before seeding a real environment.
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
