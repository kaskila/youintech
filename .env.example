# Copy to .env and fill in. See README.md "Local setup" for the full walkthrough.

# --- Local development — Postgres 17, installed natively. No pooler locally,
# so DATABASE_URL and DIRECT_URL are identical. See README.md "Local setup".
DATABASE_URL="postgresql://youintech:password@localhost:5432/youintech_db"
DIRECT_URL="postgresql://youintech:password@localhost:5432/youintech_db"

# --- Production (Neon) is set as real env vars on Vercel, never here.
# See CLAUDE.md §3.

# --- Better Auth (admin-only authentication for /admin) ---
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Seeded admin credentials — used once by prisma/seed.ts to create the
# first admin account. Change before seeding a real environment.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# --- Cloudinary (signed uploads only — see src/lib/cloudinary.ts and
# src/app/api/cloudinary/sign/route.ts). All three come from the Cloudinary
# console: Dashboard -> Product Environment Credentials.
# CLOUDINARY_API_SECRET must NEVER be exposed to the client — it's read only
# in server-side code (the signing route), never sent to the browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Resend (transactional email only — application confirmations, admin
# notifications. See CLAUDE.md §3) ---
# RESEND_API_KEY=""
# NOTIFICATION_EMAIL=""
