// ============================================================================
// YouthInTech — Prisma Schema (MVP)
//
// This file IS the domain model document. There is no separate ERD or design
// doc, by decision. Keep the comments current; they carry the reasoning.
//
// COMPLIANCE CONSTRAINT (Zambia Data Protection Act No. 3 of 2021):
//   The database is hosted outside Zambia (Neon). Cross-border transfer of
//   SENSITIVE personal data is restricted. Therefore this schema must NEVER
//   contain: health data, biometrics, religious or political affiliation,
//   NRC/passport numbers, financial account details, or criminal records.
//   If a feature seems to need one of these, the feature is wrong. Escalate,
//   do not add the column.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// AUTH — Better Auth. Staff accounts only. Frontliners do NOT get accounts.
// ============================================================================

enum Role {
  ADMIN // full access, including user management and application review
  EDITOR // content only — cannot see applications (they contain personal data)
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(EDITOR)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions     Session[]
  accounts     Account[]
  posts        Post[]
  auditLogs    AuditLog[]
  reviewedApps Application[] @relation("ApplicationReviewer")

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  // Required by Better Auth core (not optional there). For local credential
  // accounts the value is "local:credential", produced by
  // createLocalAccountIssuer(providerId) — import and call that rather than
  // hardcoding it. Sign-in matches providerId + issuer + accountId BEFORE
  // comparing passwords, so a wrong or missing value fails as "invalid email
  // or password" with no other signal.
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // hashed by Better Auth. Never touch directly.
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================================
// SECTORS — the eight focus areas.
// A table, not an enum, so wording can change without a migration.
// Seeded in prisma/seed.ts. Editable by ADMIN.
// ============================================================================

model Sector {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  tagline      String? // one line, used on cards
  description  String? // full copy for the sector page
  icon         String? // lucide icon name, not an image
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications  ApplicationSector[]
  posts         Post[]
  events        Event[]
  opportunities Opportunity[]

  @@index([isActive, displayOrder])
}

// ============================================================================
// CONTENT — Posts and Events. Created through the admin UI, never by commit.
// ============================================================================

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED // hidden from the site but never deleted
}

// ============================================================================
// PROGRAMMES — cross-sector flagship initiatives. Time-bound and applied-to,
// unlike Sector (permanent, no applications). See the Sector model above for
// the full distinction; don't conflate the two.
// ============================================================================

enum ProgrammeStatus {
  PLANNED // announced, nothing scheduled yet
  UPCOMING // scheduled — targetDate should be set
  RUNNING
  COMPLETED
}

model Programme {
  id    String @id @default(cuid())
  slug  String @unique
  title String
  summary String // required — one-line pitch, ~200 chars. Cards, detail page, SEO.
  description String? // markdown source. Rendered via react-markdown
  // (components/public/markdown.tsx) on the /programmes/[slug]
  // page — see CLAUDE.md §3. Raw HTML is disabled in that renderer.
  coverImage String? // Cloudinary public_id, not a full URL — see Post.coverImage.
  coverAlt   String?
  icon       String // lucide-react component name, not an image. Required
  // (unlike Sector.icon) — every programme card needs one.

  status     ProgrammeStatus @default(PLANNED)
  isFlagship Boolean         @default(false)

  applicationsOpen Boolean @default(false)
  applicationUrl   String? // external link. No in-house application flow —
  // see CLAUDE.md non-goals for this slice.

  targetDate DateTime? // nullable — nothing is scheduled until this is set.
  // NULL must render as "no date yet," never a placeholder date.

  displayOrder  Int           @default(0)
  contentStatus ContentStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Deliberately NO sector relation. All flagship programmes are
  // cross-sector by design — don't add a Sector FK "to make filtering
  // easier." A sector-scoped initiative would be a different model.
  @@index([contentStatus, displayOrder])
}

// ============================================================================
// OPPORTUNITIES — scholarships, fellowships, jobs, grants, internships,
// training, and competitions posted on behalf of external organisations.
// Approved in place of the original "deferred" decision (see CLAUDE.md §8),
// conditional on one thing: automatic expiry.
//
// THE RULE — do not remove or weaken this: an opportunity disappears from
// the public page the moment its deadline passes. This is enforced by the
// public query's own filter (deadline >= now), not by a cron job, not by a
// status flag an editor has to remember to flip. See
// src/app/(public)/opportunities/page.tsx. A stale opportunities feed
// (expired listings still showing) is worse than a thin one — if this
// filter is ever weakened, the feature reverts to deferred.
// ============================================================================

enum OpportunityType {
  SCHOLARSHIP
  FELLOWSHIP
  INTERNSHIP
  JOB
  GRANT
  TRAINING
  COMPETITION
  OTHER
}

model Opportunity {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  summary      String // required — one-line pitch, ~200 chars. Cards, SEO.
  description  String? // markdown source. Rendered as plain text for now —
  // see Programme.description for the same rationale.
  organisation String // who is actually offering this — YouthInTech is the
  // publisher of the listing, not (usually) the offering party.

  type OpportunityType

  location String?
  isRemote Boolean @default(false)

  deadline DateTime // REQUIRED. The whole model exists to auto-expire on
  // this date — see the header comment above. Zod rejects a
  // past deadline on create (not on update — editing a listing
  // after its deadline has passed, e.g. to fix a typo before
  // archiving it, must still be possible).

  applyUrl String // external — no in-house application flow, same pattern
  // as Programme.applicationUrl.

  eligibility String?

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  // Nullable, unlike Programme's deliberate lack of a Sector relation:
  // an opportunity is very often sector-specific (an agriculture grant, a
  // healthcare fellowship) but not always (a general leadership
  // scholarship) — nullable covers both without needing two models.

  coverImage String? // Cloudinary URL or legacy /public path — see
  coverAlt   String? // Programme.coverImage for the same dual-format rule.

  contentStatus ContentStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Serves the public query directly: WHERE contentStatus = PUBLISHED AND
  // deadline >= now(), ORDER BY deadline ASC.
  @@index([contentStatus, deadline])
}

// ============================================================================
// POSTS — "Stories": people-focused pieces about young Zambians using
// technology (not organisational announcements). Public route: /stories.
// ============================================================================

model Post {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String // required, <=200 chars — cards, SEO, OG. Live counter in the form.
  body        String // markdown source — rendered via react-markdown
  // (components/public/markdown.tsx), raw HTML disabled. See CLAUDE.md §3.
  coverImage  String? // Cloudinary secure_url (or legacy /public path) — see Programme.coverImage
  coverAlt    String? // required by lint when coverImage set
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime? // stamped ONCE, on the first DRAFT->PUBLISHED transition,
  // and never rewritten. Unpublishing does NOT clear it. See stories/actions.ts.

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([sectorId])
}

// ============================================================================
// EVENTS — conferences, workshops, meetups, and trainings YouthInTech runs
// or co-hosts.
//
// THE OPPOSITE RULE FROM OPPORTUNITY — do not apply that pattern here by
// mistake: a past event is NEVER auto-hidden, expired, or deleted.
// Opportunities expire because a stale listing (a scholarship whose
// deadline has passed) actively damages credibility — see the Opportunity
// model comment above. Events are the inverse: a growing history of past
// events IS the credibility, the proof partners and funders are scanning
// for (CLAUDE.md §1). So the public query never filters on `startsAt` —
// only on `status = PUBLISHED` — and instead sorts published rows into two
// sections by comparing `startsAt` to the current time: UPCOMING (soonest
// first) and PAST (most recent first). See (public)/events/page.tsx.
// ============================================================================

model Event {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  summary     String
  description String
  coverImage  String?
  coverAlt    String?

  startsAt DateTime
  endsAt   DateTime?
  venue    String?
  isOnline Boolean   @default(false)

  registrationUrl String? // external form/link. No in-house ticketing in MVP.
  status          ContentStatus @default(DRAFT)

  // Post-event evidence. This is what funders actually read.
  attendeeCount Int?
  recapBody     String?

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
}

// ============================================================================
// APPLICATIONS — Frontliner volunteer intake.
// The only place personal data lives. Treat every field here as regulated.
// ============================================================================

enum ApplicationStatus {
  NEW
  REVIEWING
  ACCEPTED
  DECLINED
  WITHDRAWN // set when the applicant exercises their right to object
}

model Application {
  id String @id @default(cuid())

  // --- Personal data. Non-sensitive categories only. -----------------------
  fullName    String
  email       String
  phone       String?
  city        String?
  institution String? // school, university or employer — free text
  ageBracket  String? // "16-17" | "18-24" | "25-35" | "35+".
  // A bracket, never a date of birth. Under-18 triggers
  // the safeguarding flow — see below.
  skills      String?
  motivation  String

  // --- Consent record. Required under DPA s.15. ---------------------------
  // Consent must be unbundled: one purpose, one record. Do not collapse these
  // into a single checkbox, and never pre-tick either of them in the form.
  consentedAt          DateTime // processing this application. Required.
  marketingConsent     Boolean   @default(false)
  marketingConsentAt   DateTime? // separate purpose: newsletters, campaigns.
  // Withdrawable independently of the above.
  privacyPolicyVersion String // e.g. "2026-08-01". Never overwrite a
  // published policy version — publish a new one.
  guardianConsent      Boolean   @default(false)
  // ^ Must be true before an under-18 application can move past NEW.
  //   Enforced in the review action, not just the form.

  // --- Retention. DPA: keep only as long as necessary. --------------------
  // DECIDED 2026-08 (see /privacy "How long we keep it"): 24 months from
  // last contact, then personal fields are anonymised (anonymisedAt below).
  // Set on insert by the Application submission action — see
  // Inquiry.retentionUntil / submitInquiry (contact/actions.ts) for the
  // same pattern, already wired; this model's own submission flow doesn't
  // exist yet (CLAUDE.md §9 "Applications" is still unbuilt), so nothing
  // sets this field on this model yet. Still nullable so a row created
  // before either the decision or that action exists reads as "not yet
  // determined," never "no retention limit" — the purge job MUST treat
  // NULL as "do not purge, needs review," not skip the row silently.
  retentionUntil DateTime?
  anonymisedAt DateTime? // when purged, personal fields are nulled and this
  // is stamped. The row survives for reporting counts.

  // --- Workflow -----------------------------------------------------------
  status      ApplicationStatus @default(NEW)
  reviewNotes String?
  reviewedAt  DateTime?
  reviewerId  String?
  reviewer    User?             @relation("ApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sectors ApplicationSector[]

  @@index([status, submittedAt])
  @@index([retentionUntil])
  @@index([email])
}

// Join table with an optional rank.
// This deliberately supports pick-one, pick-several AND ranked preference
// without a migration. Enforce the actual rule in the Zod schema, not here.
model ApplicationSector {
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sectorId      String
  sector        Sector      @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  rank          Int? // 1 = first choice. Null when unranked.

  @@id([applicationId, sectorId])
  @@index([sectorId])
}

// ============================================================================
// INQUIRIES — public /contact form submissions. Same personal-data handling
// pattern as Application (consent record, nullable retention, anonymisation
// stamp) — see that model's comments for the full DPA reasoning; not
// repeated field-by-field here.
// ============================================================================

enum InquiryCategory {
  VOLUNTEER
  PARTNER
  SUPPORT
  GENERAL
}

enum InquiryStatus {
  NEW
  REVIEWING
  RESPONDED
  CLOSED
}

model Inquiry {
  id String @id @default(cuid())

  category     InquiryCategory
  name         String
  email        String
  phone        String?
  organisation String?
  message      String

  // --- Age & safeguarding. Same pattern as Application.ageBracket: a
  // bracket, never a date of birth. "16-17" is the only bracket below 18
  // in this fixed set, so it's what triggers the guardian-consent
  // requirement below — enforced in submitInquiry (contact/actions.ts),
  // not just hidden in the contact form's UI. -----------------------------
  ageBracket String? // "16-17" | "18-24" | "25-35" | "35+"

  // --- Consent record. Required under DPA s.15, same rule as Application:
  // never pre-tick either checkbox at submission time. ---------------------
  consentedAt          DateTime
  privacyPolicyVersion String
  guardianConsent      Boolean @default(false)
  // ^ Required (enforced in submitInquiry, a cross-field check — see that
  //   action) when ageBracket is "16-17". Same rule as
  //   Application.guardianConsent, but checked at submission time here
  //   rather than deferred to a review action, since /contact has no
  //   review step an under-18 submission could otherwise be held at.
  guardianName  String? // required by the action when ageBracket is "16-17"
  guardianEmail String? // required by the action when ageBracket is "16-17"

  // --- Retention. DECIDED 2026-08 (see /privacy "How long we keep it"):
  // 24 months from last contact (submission), then personal fields are
  // anonymised (anonymisedAt below). Set on insert by submitInquiry. NULL
  // still means "not yet determined" for any row predating this decision,
  // never "no retention limit" — see Application.retentionUntil for the
  // full reasoning, including the purge-job rule for NULL rows.
  retentionUntil DateTime?
  anonymisedAt   DateTime?

  status InquiryStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ============================================================================
// CREDIBILITY LAYER — what partners and funders scan in the first 20 seconds.
// ============================================================================

enum PartnerTier {
  STRATEGIC
  IMPLEMENTING
  SUPPORTING
}

model Partner {
  id           String      @id @default(cuid())
  name         String
  logo         String // Cloudinary public_id
  url          String?
  tier         PartnerTier @default(SUPPORTING)
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, tier, displayOrder])
}

// Headline numbers. Editable because hardcoded stats go stale, and a funder
// seeing the same figure in March and November concludes you are dormant.
model ImpactStat {
  id           String  @id @default(cuid())
  label        String // "Youths trained"
  value        String // "1,240" — string, so "12+" and "3" both work
  note         String? // "since 2024"
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// Governance documents: constitution, policies, annual reports.
// Funders look for these. Serving them is a credibility feature, not a file dump.
model Document {
  id           String  @id @default(cuid())
  title        String
  description  String?
  fileUrl      String // Cloudinary raw upload
  fileSize     Int? // bytes. Rendered next to the link — on a
  // metered 3G bundle, "PDF · 4.2 MB" is the
  // difference between a tap and a bounce.
  category     String // "Governance" | "Reports" | "Policies"
  displayOrder Int     @default(0)
  isPublic     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublic, category, displayOrder])
}

// ============================================================================
// AUDIT — who did what. Cheap now, impossible to backfill later.
// Also serves DPA s.45 (records of processing activities).
// ============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  action     String // "application.viewed", "post.published", "application.purged"
  entityType String
  entityId   String?
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
